<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/ ..\FrameXML\UI.xsd">

    <!-- DarkChaos Transmutation UI -->

    <Frame name="DarkChaos_TransmutationFrame" parent="UIParent" movable="true" enableMouse="true" hidden="true" toplevel="true">
        <Size x="600" y="500"/>
        <Anchors>
            <Anchor point="CENTER"/>
        </Anchors>
        <Backdrop bgFile="Interface\DialogFrame\UI-DialogBox-Background" edgeFile="Interface\DialogFrame\UI-DialogBox-Border" tile="true">
            <BackgroundInsets>
                <AbsInset left="11" right="12" top="12" bottom="11"/>
            </BackgroundInsets>
            <TileSize>
                <AbsValue val="32"/>
            </TileSize>
            <EdgeSize>
                <AbsValue val="32"/>
            </EdgeSize>
        </Backdrop>

        <Layers>
            <Layer level="ARTWORK">
                <FontString parentKey="TitleText" inherits="GameFontNormalLarge" text="Transmutation Master" justifyH="CENTER">
                    <Anchors>
                        <Anchor point="TOP" x="0" y="-12"/>
                    </Anchors>
                </FontString>
            </Layer>
        </Layers>

        <Frames>
            <Button name="$parentCloseButton" inherits="UIPanelCloseButton">
                <Anchors>
                    <Anchor point="TOPRIGHT" x="-5" y="-5"/>
                </Anchors>
            </Button>

            <!-- Tabs -->
            <!-- Single tab active: Exchange -->

            <!-- Tab 1: Currency Exchange -->
            <Frame name="DarkChaos_TransmutationExchangeFrame" parentKey="ExchangeFrame" hidden="false">
                <Anchors>
                    <Anchor point="TOPLEFT" x="20" y="-40"/>
                    <Anchor point="BOTTOMRIGHT" x="-20" y="40"/>
                </Anchors>
                <Layers>
                    <Layer level="ARTWORK">
                        <FontString parentKey="BalanceText" inherits="GameFontHighlightLarge" text="Loading Balances..." justifyH="CENTER">
                            <Anchors>
                                <Anchor point="TOP" y="-10"/>
                            </Anchors>
                        </FontString>
                        <!-- Dropdown captions. UIDropDownMenuTemplate has no label of
                             its own, so the column headings live here. -->
                        <FontString parentKey="FromLabel" inherits="GameFontNormal" text="Give" justifyH="CENTER">
                            <Anchors>
                                <Anchor point="TOP" x="-115" y="-44"/>
                            </Anchors>
                        </FontString>
                        <FontString parentKey="ToLabel" inherits="GameFontNormal" text="Receive" justifyH="CENTER">
                            <Anchors>
                                <Anchor point="TOP" x="115" y="-44"/>
                            </Anchors>
                        </FontString>
                        <FontString parentKey="PreviewText" inherits="GameFontHighlight" text="" justifyH="CENTER">
                            <Anchors>
                                <Anchor point="TOP" y="-150"/>
                            </Anchors>
                        </FontString>
                        <FontString parentKey="RateText" inherits="GameFontDisableSmall" text="Exchange Rates" justifyH="CENTER">
                            <Anchors>
                                <Anchor point="BOTTOM" y="10"/>
                            </Anchors>
                        </FontString>
                    </Layer>
                </Layers>
                <Frames>
                    <!-- Frame, not Button: UIDropDownMenuTemplate is a Frame template
                         in 3.3.5 and inheriting it on a Button silently breaks the
                         menu's own child buttons. -->
                    <Frame name="$parentFromDropdown" parentKey="FromDropdown" inherits="UIDropDownMenuTemplate">
                        <Anchors>
                            <Anchor point="TOP" x="-115" y="-60"/>
                        </Anchors>
                    </Frame>
                    <Frame name="$parentToDropdown" parentKey="ToDropdown" inherits="UIDropDownMenuTemplate">
                        <Anchors>
                            <Anchor point="TOP" x="115" y="-60"/>
                        </Anchors>
                    </Frame>

                    <EditBox name="$parentAmountInput" parentKey="AmountInput" inherits="InputBoxTemplate" autoFocus="false" numeric="true">
                        <Size x="80" y="20"/>
                        <Anchors>
                            <Anchor point="TOP" x="20" y="-115"/>
                        </Anchors>
                        <Layers>
                            <Layer level="ARTWORK">
                                <FontString inherits="GameFontNormal" text="Amount:">
                                    <Anchors>
                                        <Anchor point="RIGHT" relativePoint="LEFT" x="-5" y="0"/>
                                    </Anchors>
                                </FontString>
                            </Layer>
                        </Layers>
                        <Scripts>
                            <OnLoad>
                                this:SetText("1");
                            </OnLoad>
                            <OnTextChanged>
                                DarkChaos_Transmutation_UpdateExchangeCalculations();
                            </OnTextChanged>
                            <OnEnterPressed>
                                DarkChaos_Transmutation_DoExchange();
                            </OnEnterPressed>
                            <OnEscapePressed>
                                this:ClearFocus();
                            </OnEscapePressed>
                        </Scripts>
                    </EditBox>

                    <Button name="$parentMaxBtn" parentKey="MaxBtn" inherits="UIPanelButtonTemplate" text="Max">
                        <Size x="50" y="22"/>
                        <Anchors>
                            <Anchor point="LEFT" relativeTo="$parentAmountInput" relativePoint="RIGHT" x="8" y="0"/>
                        </Anchors>
                        <Scripts>
                            <OnClick>
                                DarkChaos_Transmutation_FillMax();
                            </OnClick>
                        </Scripts>
                    </Button>

                    <Button name="$parentExchangeBtn" parentKey="ExchangeBtn" inherits="UIPanelButtonTemplate" text="Exchange">
                        <Size x="160" y="30"/>
                        <Anchors>
                            <Anchor point="TOP" y="-185"/>
                        </Anchors>
                        <Scripts>
                            <OnClick>
                                DarkChaos_Transmutation_DoExchange();
                            </OnClick>
                        </Scripts>
                    </Button>
                </Frames>
            </Frame>                    

        </Frames>
        <Scripts>
            <OnLoad>
                DarkChaos_Transmutation_OnLoad(this);
            </OnLoad>
            <OnShow>
                DarkChaos_Transmutation_OnShow();
            </OnShow>
        </Scripts>
    </Frame>
</Ui>
